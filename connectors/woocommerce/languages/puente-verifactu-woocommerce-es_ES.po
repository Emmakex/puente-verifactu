msgid ""
msgstr ""
"Project-Id-Version: Puente VeriFactu for WooCommerce 0.2.0\n"
"Language: es_ES\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Puente VeriFactu for WooCommerce requires WooCommerce to be active."
msgstr "Puente VeriFactu para WooCommerce requiere que WooCommerce esté activo."

msgid "Puente VeriFactu"
msgstr "Puente VeriFactu"

msgid "You are not allowed to change these settings."
msgstr "No tienes permisos para cambiar estos ajustes."

msgid "The Puente URL must use HTTPS."
msgstr "La URL de Puente debe usar HTTPS."

msgid "Invoice number meta key is required when that source is selected."
msgstr "La meta-key del número de factura es obligatoria cuando se selecciona esa fuente."

msgid "Automatic refunds require a refund mapping profile and refund invoice number meta key."
msgstr "Los reembolsos automáticos requieren un perfil de mapeo rectificativo y la meta-key del número de factura rectificativa."

msgid "The API token could not be encrypted on this server."
msgstr "No se pudo cifrar el token de API en este servidor."

msgid "Puente VeriFactu settings saved."
msgstr "Ajustes de Puente VeriFactu guardados."

msgid "WooCommerce sends neutral order data to Puente VeriFactu. Fiscal rules, AEAT XML, certificates and hash chains stay outside WordPress."
msgstr "WooCommerce envía datos neutrales del pedido a Puente VeriFactu. Las reglas fiscales, el XML de AEAT, los certificados y la cadena de huellas permanecen fuera de WordPress."

msgid "Puente URL"
msgstr "URL de Puente"

msgid "Mapping profile ID"
msgstr "ID del perfil de mapeo"

msgid "Refund mapping profile ID"
msgstr "ID del perfil de mapeo para rectificativas"

msgid "Use a separate server-side profile for corrective invoices. WooCommerce never selects R1–R5 or S/I."
msgstr "Usa un perfil server-side independiente para facturas rectificativas. WooCommerce nunca selecciona R1–R5 ni S/I."

msgid "API token"
msgstr "Token de API"

msgid "Stored securely — leave blank to keep it"
msgstr "Guardado de forma segura — déjalo en blanco para conservarlo"

msgid "Not configured"
msgstr "No configurado"

msgid "Remove stored token"
msgstr "Eliminar token guardado"

msgid "Invoice number source"
msgstr "Fuente del número de factura"

msgid "Not configured — preflight will block"
msgstr "Sin configurar — el preflight bloqueará el envío"

msgid "Order meta key from an invoice plugin"
msgstr "Meta-key del pedido de un plugin de facturación"

msgid "WooCommerce order number (explicitly use as invoice number)"
msgstr "Número de pedido de WooCommerce (usar explícitamente como número de factura)"

msgid "WooCommerce orders are not automatically fiscal invoices. Choose the real invoice numbering source explicitly."
msgstr "Los pedidos de WooCommerce no son automáticamente facturas fiscales. Elige explícitamente la fuente real de numeración de facturas."

msgid "Invoice number meta key"
msgstr "Meta-key del número de factura"

msgid "Required only when using an existing invoice plugin/meta field."
msgstr "Solo es obligatoria cuando se utiliza un plugin de facturación o campo meta existente."

msgid "Refund invoice number meta key"
msgstr "Meta-key del número de factura rectificativa"

msgid "The corrective invoice must have its own fiscal number. No WooCommerce refund ID is used automatically."
msgstr "La factura rectificativa debe tener su propio número fiscal. El ID de reembolso de WooCommerce nunca se usa automáticamente."

msgid "Automatic statuses"
msgstr "Estados automáticos"

msgid "Leave all unchecked for manual-only mode."
msgstr "Déjalos todos sin marcar para usar solo el modo manual."

msgid "Automatic refunds"
msgstr "Reembolsos automáticos"

msgid "Queue new WooCommerce refunds for corrective-invoice preflight and submission."
msgstr "Encola los nuevos reembolsos de WooCommerce para preflight y envío como factura rectificativa."

msgid "Disabled by default. Enable only after the corrective mapping profile and refund invoice numbering are validated."
msgstr "Desactivado por defecto. Actívalo solo después de validar el perfil rectificativo y la numeración fiscal de los reembolsos."

msgid "Customer tax ID meta key"
msgstr "Meta-key del NIF/CIF del cliente"

msgid "Optional. Use the meta key already used by your VAT/NIF plugin. The connector never assumes a third-party field name."
msgstr "Opcional. Usa la meta-key que ya utiliza tu plugin de IVA/NIF. El conector nunca presupone el nombre de un campo de terceros."

msgid "HTTP timeout (seconds)"
msgstr "Timeout HTTP (segundos)"

msgid "The Puente record ID is invalid."
msgstr "El ID de registro de Puente no es válido."

msgid "Puente VeriFactu is not fully configured."
msgstr "Puente VeriFactu no está completamente configurado."

msgid "Puente VeriFactu requires an HTTPS endpoint."
msgstr "Puente VeriFactu requiere un endpoint HTTPS."

msgid "Puente VeriFactu could not be reached."
msgstr "No se pudo conectar con Puente VeriFactu."

msgid "Puente VeriFactu returned an invalid response."
msgstr "Puente VeriFactu devolvió una respuesta no válida."

msgid "Puente VeriFactu rejected the request."
msgstr "Puente VeriFactu rechazó la solicitud."

msgid "WooCommerce customer"
msgstr "Cliente de WooCommerce"

msgid "Puente VeriFactu: validate without sending"
msgstr "Puente VeriFactu: validar sin enviar"

msgid "Puente VeriFactu: refresh status"
msgstr "Puente VeriFactu: actualizar estado"

msgid "Puente VeriFactu: send"
msgstr "Puente VeriFactu: enviar"

msgid "Puente VeriFactu: process refunds"
msgstr "Puente VeriFactu: procesar reembolsos"

msgid "Puente VeriFactu preflight found data that must be corrected before sending."
msgstr "El preflight de Puente VeriFactu encontró datos que deben corregirse antes de enviar."

msgid "Puente VeriFactu preflight passed. Nothing was sent to AEAT."
msgstr "El preflight de Puente VeriFactu se superó. No se envió nada a AEAT."

msgid "Puente VeriFactu send queued."
msgstr "Envío a Puente VeriFactu encolado."

msgid "Puente VeriFactu refund processing queued."
msgstr "Procesamiento de reembolsos de Puente VeriFactu encolado."

msgid "Preflight failed. The order was not fiscalized."
msgstr "El preflight falló. El pedido no se fiscalizó."

msgid "Puente VeriFactu did not return a record ID."
msgstr "Puente VeriFactu no devolvió un ID de registro."

msgid "Puente VeriFactu created record %s."
msgstr "Puente VeriFactu creó el registro %s."

msgid "The original invoice must be fiscalized before its refund can be processed."
msgstr "La factura original debe estar fiscalizada antes de procesar su reembolso."

msgid "Refund mapping profile is not configured."
msgstr "El perfil de mapeo para rectificativas no está configurado."

msgid "Corrective-invoice preflight failed. The refund was not fiscalized."
msgstr "El preflight de la factura rectificativa falló. El reembolso no se fiscalizó."

msgid "Puente VeriFactu did not return a corrective record ID."
msgstr "Puente VeriFactu no devolvió un ID de registro rectificativo."

msgid "Puente VeriFactu created corrective record %1$s for refund #%2$d."
msgstr "Puente VeriFactu creó el registro rectificativo %1$s para el reembolso #%2$d."

msgid "VeriFactu"
msgstr "VeriFactu"

msgid "Not available"
msgstr "No disponible"

msgid "Synced"
msgstr "Sincronizado"

msgid "Pending / review"
msgstr "Pendiente / revisar"

msgid "Action required"
msgstr "Requiere acción"

msgid "Not sent"
msgstr "No enviado"

msgid "No Puente VeriFactu operation exists yet."
msgstr "Todavía no existe ninguna operación de Puente VeriFactu."

msgid "%d refund"
msgid_plural "%d refunds"
msgstr[0] "%d reembolso"
msgstr[1] "%d reembolsos"
