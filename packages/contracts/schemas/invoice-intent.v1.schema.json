{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kairoseth.com/schemas/puente-verifactu/invoice-intent.v1.schema.json",
  "title": "Puente VeriFactu InvoiceIntent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "operation",
    "organizationId",
    "installationId",
    "sourceSystem",
    "sourceInvoiceId",
    "number",
    "issueDate",
    "invoiceType",
    "description",
    "issuer",
    "currency",
    "taxBreakdown",
    "totals"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "operation": { "const": "issue" },
    "organizationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "installationId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceSystem": { "type": "string", "minLength": 1, "maxLength": 128 },
    "sourceInvoiceId": { "type": "string", "minLength": 1, "maxLength": 256 },
    "series": { "type": "string", "maxLength": 120 },
    "number": { "type": "string", "minLength": 1, "maxLength": 120 },
    "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "invoiceType": { "enum": ["F1", "F2", "F3", "R1", "R2", "R3", "R4", "R5"] },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "issuer": { "$ref": "#/$defs/party" },
    "recipients": {
      "type": "array",
      "items": { "$ref": "#/$defs/party" },
      "maxItems": 100
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "taxBreakdown": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/taxLine" }
    },
    "adjustments": {
      "type": "array",
      "items": { "$ref": "#/$defs/adjustment" }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseAmount", "taxAmount", "totalAmount"],
      "properties": {
        "baseAmount": { "$ref": "#/$defs/amount" },
        "taxAmount": { "$ref": "#/$defs/amount" },
        "totalAmount": { "$ref": "#/$defs/amount" }
      }
    },
    "rectification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["S", "I"] },
        "correctedBaseAmount": { "$ref": "#/$defs/amount" },
        "correctedTaxAmount": { "$ref": "#/$defs/amount" },
        "originalInvoices": {
          "type": "array",
          "items": { "$ref": "#/$defs/invoiceReference" }
        }
      }
    },
    "replacedInvoices": {
      "type": "array",
      "items": { "$ref": "#/$defs/invoiceReference" }
    },
    "sourceMetadata": { "type": "object" }
  },
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^-?\\d+(?:\\.\\d{1,2})?$"
    },
    "rate": {
      "type": "string",
      "pattern": "^-?\\d+(?:\\.\\d{1,4})?$"
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "taxId": { "type": "string", "minLength": 1, "maxLength": 20 },
        "otherId": {
          "type": "object",
          "additionalProperties": false,
          "required": ["countryCode", "idType", "id"],
          "properties": {
            "countryCode": { "type": "string", "pattern": "^[A-Z]{2}$" },
            "idType": { "enum": ["02", "03", "04", "05", "06"] },
            "id": { "type": "string", "minLength": 1, "maxLength": 20 }
          }
        }
      }
    },
    "taxLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taxCode", "regimeKey", "operationClass", "baseAmount", "taxAmount"],
      "properties": {
        "taxCode": { "type": "string", "minLength": 1, "maxLength": 2 },
        "regimeKey": { "type": "string", "minLength": 1, "maxLength": 2 },
        "operationClass": { "type": "string", "minLength": 1, "maxLength": 2 },
        "rate": { "$ref": "#/$defs/rate" },
        "baseAmount": { "$ref": "#/$defs/amount" },
        "taxAmount": { "$ref": "#/$defs/amount" }
      }
    },
    "adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "enum": ["withholding", "surcharge", "discount", "other"] },
        "amount": { "$ref": "#/$defs/amount" },
        "description": { "type": "string", "maxLength": 200 }
      }
    },
    "invoiceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number"],
      "properties": {
        "series": { "type": "string", "maxLength": 120 },
        "number": { "type": "string", "minLength": 1, "maxLength": 120 },
        "issueDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    }
  }
}
