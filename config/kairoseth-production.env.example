# Kairoseth Fiscal productive runtime (Hostinger + MongoDB Atlas)
# Copy values into Hostinger environment variables / private files outside public_html and the managed nodejs build directory.
# Never commit real values.

NODE_ENV=production
PV_HOST=0.0.0.0
PV_PORT=3000

MONGODB_URI=<KAIROSETH_MONGODB_ATLAS_URI>
MONGODB_DB_NAME=kairoseth

PV_AUTH_CONFIG_PATH=/private/kairoseth-fiscal/auth.json
PV_RESPONSIBLE_DECLARATION_PATH=/private/kairoseth-fiscal/declaracion-responsable-v0.1.0.md
PV_KAIROSETH_BACKUP_REPORT_PATH=/private/kairoseth-fiscal/backup-report.json
PV_INTEGRATION_SECRETS_PATH=/private/kairoseth-fiscal/integration-secrets.json
# Optional static EUR conversion/reference fallback:
# PV_INTEGRATION_CONFIG_PATH=/private/kairoseth-fiscal/integrations.json

PV_SIF_PRODUCER_NAME=<PRODUCTOR_REAL>
PV_SIF_PRODUCER_TAX_ID=<NIF_PRODUCTOR_REAL>
PV_SIF_SOFTWARE_NAME=Puente VeriFactu
PV_SIF_SYSTEM_ID=PV
PV_SIF_INSTALLATION_NUMBER=001
PV_TIME_ZONE=Europe/Madrid

# Safe default for deployment/pilot until production AEAT is explicitly approved.
PV_AEAT_ENVIRONMENT=test
# Required only when PV_AEAT_ENVIRONMENT=production:
# PV_AEAT_ALLOW_PRODUCTION=YES

PV_AEAT_PFX_PATH=/private/kairoseth-fiscal/aeat.pfx
PV_AEAT_PFX_PASSPHRASE_FILE=/private/kairoseth-fiscal/aeat-pfx-passphrase
# Do not configure PV_AEAT_PFX_PASSPHRASE at the same time as the file source.

PV_AEAT_DISPATCH_INTERVAL_MS=1000
PV_AEAT_DISPATCH_BATCH_SIZE=25
PV_AEAT_LEASE_MS=30000
PV_AEAT_MAX_ATTEMPTS=5
